{
  "name": "necrofall",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "NECROFALL - spherical mini-planet PvPvE auto-shooter (Three.js + TypeScript + WebRTC P2P)",
  "scripts": {
    "dev": "vite",
    "dev:concepts": "vite --config src/concepts/vite.config.ts",
    "dev:base-planets": "npm run dev:concepts",
    "build:base-planets": "npm run build:concepts",
    "test:base-planets": "node scripts/check-concepts.mjs --bases",
    "check:concepts": "tsc -p src/concepts/tsconfig.json",
    "test:concepts": "node scripts/check-concepts.mjs",
    "test:assets": "node scripts/check-concepts.mjs --assets",
    "test:states": "node scripts/check-concepts.mjs --states",
    "build:concepts": "npm run check:concepts && vite build --config src/concepts/vite.config.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:player-avatar": "node scripts/check-player-avatar.mjs",
    "prepare:avatar": "node scripts/prepare-player-avatar.mjs",
    "test:main-planets": "node scripts/check-main-planets.mjs",
    "test:enemy-models": "node scripts/check-enemy-base-models.mjs",
    "test:enemy-rigs": "node scripts/check-enemy-rigs.mjs",
    "test:match-performance": "node scripts/check-match-performance.mjs",
    "prepare:behemoth": "node scripts/prepare-behemoth-base-model.mjs",
    "test:planet-physics": "node scripts/check-planet-physics.mjs",
    "test:universe": "node scripts/ring-parity.mjs"
  },
  "dependencies": {
    "peerjs": "^1.5.4",
    "spacetimedb": "^2.10.1",
    "three": "0.186.1",
    "three-mesh-bvh": "^0.9.16"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.64.0",
    "@types/three": "0.186.0",
    "draco3d": "^1.5.7",
    "manifold-3d": "^3.5.4",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
