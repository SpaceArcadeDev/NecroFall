# ---------------------------------------------------------------
# NECROFALL / SPACETIMEDB
# ---------------------------------------------------------------
# Copy this file to `.env.local` (never commit real values) and fill in the
# fields. The client reads these through Vite (`import.meta.env`).
#
# If VITE_SPACETIMEDB_URI or VITE_SPACETIMEDB_DB_NAME is missing the game
# boots straight into the legacy P2P/offline menu — the account shell, official
# matchmaking and the profile pages stay off, and nothing else changes.

# SpacetimeDB Maincloud websocket/API host (local dev: http://localhost:3000)
VITE_SPACETIMEDB_URI=https://maincloud.spacetimedb.com

# Your deployed SpacetimeDB database/module name
VITE_SPACETIMEDB_DB_NAME=necrofall

# ---------------------------------------------------------------
# SPACETIMEAUTH / OIDC
# ---------------------------------------------------------------
# Managed OIDC provider for SpacetimeDB applications. Only the client ID is
# public — NEVER ship a client secret in the Vite environment.
VITE_SPACETIMEAUTH_AUTHORITY=https://auth.spacetimedb.com/oidc

# Public OIDC client ID from the SpacetimeAuth dashboard
VITE_SPACETIMEAUTH_CLIENT_ID=YOUR_CLIENT_ID

# Existing Vercel game URL — must be registered as a redirect URI in SpacetimeAuth
VITE_SPACETIMEAUTH_REDIRECT_URI=https://necrofall.vercel.app/auth/callback

# Where the user goes after logout
VITE_SPACETIMEAUTH_POST_LOGOUT_URI=https://necrofall.vercel.app/

VITE_SPACETIMEAUTH_SCOPE=openid profile email

# ---------------------------------------------------------------
# MULTIPLAYER
# ---------------------------------------------------------------
# true = show the P2P option on the PLAY page (existing WebRTC lobbies)
VITE_P2P_ENABLED=true

# Default Play mode: official | p2p
VITE_DEFAULT_MULTIPLAYER_MODE=official

# ---------------------------------------------------------------
# DEVELOPMENT
# ---------------------------------------------------------------
VITE_SPACETIMEDB_ENV=production

# IMPORTANT
# Never place SPACETIMEAUTH_CLIENT_SECRET (or any OIDC/Google/Steam client
# secret) in this file. Browser auth uses the client ID + PKCE only.
